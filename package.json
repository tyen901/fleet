{
  "name": "fleet-workspace",
  "private": true,
  "devDependencies": {
    "prettier": "^3.2.5"
  },
  "scripts": {
    "fmt:css": "prettier --write \"apps/fleet/assets/css/**/*.css\"",
    "lint:css": "prettier --check \"apps/fleet/assets/css/**/*.css\"",
    "lint:design": "node scripts/lint-design.mjs",
    "render:ui": "npm run build:no-flux && node scripts/render-ui.mjs",
    "build:no-flux": "node scripts/cargo-no-flux.mjs build -p fleet --locked"
  }
}
